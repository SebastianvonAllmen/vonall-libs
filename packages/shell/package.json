{
	"name": "@vonall/shell",
	"version": "0.1.0",
	"description": "The app shell behind login of a Web App Factory Product: sidebar, mobile header and tabs, breadcrumbs, the account menu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianvonAllmen/vonall-libs.git",
		"directory": "packages/shell"
	},
	"type": "module",
	"scripts": {
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run --project unit --passWithNoTests",
		"test:db": "vitest run --project db --passWithNoTests",
		"build": "svelte-kit sync && svelte-package && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./messages": {
			"types": "./dist/messages.d.ts",
			"default": "./dist/messages.js"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "8.3.4",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@lucide/svelte": "1.22.0",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1"
	}
}
