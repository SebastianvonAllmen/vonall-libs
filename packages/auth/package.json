{
	"name": "@vonall/auth",
	"version": "0.4.0",
	"description": "Accounts for a Web App Factory Product: better-auth with the hooks, the protected helpers, Einladungen, Konto, the auth pages and the settings; Admin as an option",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianvonAllmen/vonall-libs.git",
		"directory": "packages/auth"
	},
	"type": "module",
	"scripts": {
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run --project unit --passWithNoTests",
		"test:db": "vitest run --project db --passWithNoTests",
		"build": "svelte-kit sync && svelte-package && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"CHANGELOG.md"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./messages": {
			"types": "./dist/messages.d.ts",
			"default": "./dist/messages.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		},
		"./remote": {
			"types": "./dist/remote/index.d.ts",
			"default": "./dist/remote/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"svelte": "./dist/ui/index.js",
			"default": "./dist/ui/index.js"
		}
	},
	"peerDependencies": {
		"@node-rs/argon2": "^2.2.2",
		"@sveltejs/kit": "^3.1.0",
		"drizzle-orm": "^0.45.4",
		"neverthrow": "^8.2.0",
		"pg": "^8.23.1",
		"svelte": "^5.57.2",
		"zod": "^4.6.7",
		"svelte-sonner": "^1.2.1",
		"bits-ui": "^2.19.5",
		"@lucide/svelte": "^1.22.0"
	},
	"devDependencies": {
		"@better-auth/mcp": "^1.7.12",
		"@better-auth/oauth-provider": "^1.7.12",
		"@node-rs/argon2": "^2.2.2",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"neverthrow": "^8.2.0",
		"pg": "^8.23.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "8.3.4",
		"vitest": "^5.0.5",
		"zod": "^4.6.7",
		"svelte-sonner": "^1.2.1",
		"bits-ui": "^2.19.5",
		"@lucide/svelte": "^1.22.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@vonall/mail": "workspace:^",
		"@vonall/messages": "workspace:^",
		"better-auth": "^1.7.12",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"uqr": "^0.1.3"
	}
}
